      {
        "name": "Fact_PrecioObra",
        "description": "Grano: una fila por obra ofrecida en un tamaño de lienzo (product_size.csv)",
        "columns": [
          {
            "name": "ObraKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "ObraKey",
            "summarizeBy": "none"
          },
          {
            "name": "ArtistaKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "ArtistaKey",
            "summarizeBy": "none"
          },
          {
            "name": "MuseoKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "MuseoKey",
            "summarizeBy": "none"
          },
          {
            "name": "TamanoKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "TamanoKey",
            "summarizeBy": "none"
          },
          {
            "name": "EstiloKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "EstiloKey",
            "summarizeBy": "none"
          },
          {
            "name": "TemaKey",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "TemaKey",
            "summarizeBy": "none"
          },
          {
            "name": "PrecioVenta",
            "dataType": "double",
            "sourceColumn": "PrecioVenta",
            "formatString": "#,0.00",
            "summarizeBy": "none"
          },
          {
            "name": "PrecioRegular",
            "dataType": "double",
            "sourceColumn": "PrecioRegular",
            "formatString": "#,0.00",
            "summarizeBy": "none"
          },
          {
            "name": "Descuento",
            "dataType": "double",
            "sourceColumn": "Descuento",
            "formatString": "#,0.00",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Fact_PrecioObra",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/PEGASUSPLUS;DW_FamousPaintings\",",
                "    dbo_Fact_PrecioObra = Source{[Schema=\"dbo\",Item=\"Fact_PrecioObra\"]}[Data],",
                "    Columnas = Table.SelectColumns(dbo_Fact_PrecioObra, {\"ObraKey\", \"ArtistaKey\", \"MuseoKey\", \"TamanoKey\", \"EstiloKey\", \"TemaKey\", \"PrecioVenta\", \"PrecioRegular\", \"Descuento\"})",
                "in",
                "    Columnas"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Ofertas",
            "description": "Número de combinaciones obra-tamaño con precio",
            "expression": "COUNTROWS('Fact_PrecioObra')",
            "formatString": "#,0"
          },
          {
            "name": "Obras",
            "description": "Número de obras distintas",
            "expression": "DISTINCTCOUNT('Fact_PrecioObra'[ObraKey])",
            "formatString": "#,0"
          },
          {
            "name": "Precio Venta Promedio",
            "description": "Promedio del precio de venta",
            "expression": "AVERAGE('Fact_PrecioObra'[PrecioVenta])",
            "formatString": "#,0.00"
          },
          {
            "name": "Precio Regular Promedio",
            "description": "Promedio del precio regular",
            "expression": "AVERAGE('Fact_PrecioObra'[PrecioRegular])",
            "formatString": "#,0.00"
          },
          {
            "name": "Precio Venta Minimo",
            "description": "Precio de venta más bajo",
            "expression": "MIN('Fact_PrecioObra'[PrecioVenta])",
            "formatString": "#,0.00"
          },
          {
            "name": "Precio Venta Maximo",
            "description": "Precio de venta más alto",
            "expression": "MAX('Fact_PrecioObra'[PrecioVenta])",
            "formatString": "#,0.00"
          },
          {
            "name": "Descuento Promedio",
            "description": "Promedio de (precio regular - precio de venta)",
            "expression": "AVERAGE('Fact_PrecioObra'[Descuento])",
            "formatString": "#,0.00"
          },
          {
            "name": "% Descuento",
            "description": "Descuento total / precio regular total",
            "expression": "DIVIDE(SUM('Fact_PrecioObra'[Descuento]), SUM('Fact_PrecioObra'[PrecioRegular]))",
            "formatString": "0.00 %;-0.00 %;0.00 %"
          }
        ]
      }
    ],
