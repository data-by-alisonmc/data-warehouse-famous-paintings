          SQLTask:SqlStatementSource="-- Borra el contenido del modelo estrella (primero el hecho, luego las dimensiones)&#10;DELETE FROM dbo.Fact_PrecioObra;&#10;DELETE FROM dbo.Dim_Obra;&#10;DELETE FROM dbo.Dim_Artista;&#10;DELETE FROM dbo.Dim_Museo;&#10;DELETE FROM dbo.Dim_Tamano;&#10;DELETE FROM dbo.Dim_Estilo;&#10;DELETE FROM dbo.Dim_Tema;&#10;-- Reinicia las claves sustitutas en 1 (solo si la tabla ya tuvo filas antes)&#10;IF EXISTS (SELECT 1 FROM sys.identity_columns WHERE object_id = OBJECT_ID('dbo.Dim_Obra')    AND last_value IS NOT NULL) DBCC CHECKIDENT ('dbo.Dim_Obra', RESEED, 0);&#10;IF EXISTS (SELECT 1 FROM sys.identity_columns WHERE object_id = OBJECT_ID('dbo.Dim_Artista') AND last_value IS NOT NULL) DBCC CHECKIDENT ('dbo.Dim_Artista', RESEED, 0);&#10;IF EXISTS (SELECT 1 FROM sys.identity_columns WHERE object_id = OBJECT_ID('dbo.Dim_Museo')   AND last_value IS NOT NULL) DBCC CHECKIDENT ('dbo.Dim_Museo', RESEED, 0);&#10;IF EXISTS (SELECT 1 FROM sys.identity_columns WHERE object_id = OBJECT_ID('dbo.Dim_Tamano')  AND last_value IS NOT NULL) DBCC CHECKIDENT ('dbo.Dim_Tamano', RESEED, 0);&#10;IF EXISTS (SELECT 1 FROM sys.identity_columns WHERE object_id = OBJECT_ID('dbo.Dim_Estilo')  AND last_value IS NOT NULL) DBCC CHECKIDENT ('dbo.Dim_Estilo', RESEED, 0);&#10;IF EXISTS (SELECT 1 FROM sys.identity_columns WHERE object_id = OBJECT_ID('dbo.Dim_Tema')    AND last_value IS NOT NULL) DBCC CHECKIDENT ('dbo.Dim_Tema', RESEED, 0);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Dim_Artista"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B1EA9062-B463-4A6E-97F0-5D71B492F2FD}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Dim_Artista"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AC43ABAC-3A45-4CC0-8CC7-86391D0CC456}"
          SQLTask:TimeOut="0"
          SQLTask:SqlStatementSource="-- Dimensión Artista: una fila por artista (artist.csv)&#10;INSERT INTO dbo.Dim_Artista (artist_id, NombreCompleto, Nombre, Apellido, Nacionalidad, EstiloArtista, Nacimiento, Muerte)&#10;SELECT CAST(artist_id AS INT),&#10;       LTRIM(RTRIM(full_name)),&#10;       NULLIF(LTRIM(RTRIM(first_name)), ''),&#10;       NULLIF(LTRIM(RTRIM(last_name)), ''),&#10;       NULLIF(LTRIM(RTRIM(nationality)), ''),&#10;       NULLIF(LTRIM(RTRIM(style)), ''),&#10;       TRY_CAST(birth AS INT),&#10;       TRY_CAST(death AS INT)&#10;FROM (SELECT DISTINCT * FROM stg.artist) a;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Dim_Museo"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8446FF69-E49D-429A-B1FA-0E2375CC610F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Dim_Museo"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AC43ABAC-3A45-4CC0-8CC7-86391D0CC456}"
          SQLTask:TimeOut="0"
          SQLTask:SqlStatementSource="-- Dimensión Museo (museum.csv + museum_hours.csv)&#10;-- Limpieza: si la ciudad es un número (código postal), la ciudad real está en &quot;state&quot;;&#10;--           &quot;United Kingdom&quot; se unifica como &quot;UK&quot;; &quot;Thusday&quot; se corrige a &quot;Thursday&quot;.&#10;INSERT INTO dbo.Dim_Museo (museum_id, NombreMuseo, Ciudad, Estado, Pais, DiasAbiertoSemana)&#10;SELECT CAST(m.museum_id AS INT),&#10;       LTRIM(RTRIM(m.name)),&#10;       CASE WHEN TRY_CAST(m.city AS INT) IS NOT NULL THEN NULLIF(LTRIM(RTRIM(m.state)), '') ELSE NULLIF(LTRIM(RTRIM(m.city)), '') END,&#10;       CASE WHEN TRY_CAST(m.city AS INT) IS NOT NULL THEN NULL ELSE NULLIF(LTRIM(RTRIM(m.state)), '') END,&#10;       CASE WHEN LTRIM(RTRIM(m.country)) = 'United Kingdom' THEN 'UK' ELSE LTRIM(RTRIM(m.country)) END,&#10;       h.Dias&#10;FROM (SELECT DISTINCT * FROM stg.museum) m&#10;LEFT JOIN (SELECT museum_id,&#10;                  COUNT(DISTINCT REPLACE(LTRIM(RTRIM(day)), 'Thusday', 'Thursday')) AS Dias&#10;           FROM stg.museum_hours&#10;           GROUP BY museum_id) h ON h.museum_id = m.museum_id;&#10;-- Miembro &quot;Sin museo&quot; para las obras que no indican museo (decisión C)&#10;INSERT INTO dbo.Dim_Museo (museum_id, NombreMuseo, Ciudad, Estado, Pais, DiasAbiertoSemana)&#10;VALUES (-1, 'Sin museo', 'Desconocida', NULL, 'Desconocido', NULL);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Dim_Tamano"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2556D405-BC0C-44BA-9A19-9A245241A482}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Dim_Tamano"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AC43ABAC-3A45-4CC0-8CC7-86391D0CC456}"
          SQLTask:TimeOut="0"
          SQLTask:SqlStatementSource="-- Dimensión Tamaño (canvas_size.csv). Alto vacío = medida de &quot;lado largo&quot; -&gt; NULL&#10;INSERT INTO dbo.Dim_Tamano (size_id, Ancho, Alto, Etiqueta)&#10;SELECT CAST(size_id AS INT),&#10;       TRY_CAST(width AS INT),&#10;       TRY_CAST(NULLIF(LTRIM(RTRIM(height)), '') AS INT),&#10;       LTRIM(RTRIM(label))&#10;FROM (SELECT DISTINCT * FROM stg.canvas_size) c;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Dim_Estilo"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{36AB37A3-15B0-417C-B7F4-B9A6751A7355}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Dim_Estilo"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AC43ABAC-3A45-4CC0-8CC7-86391D0CC456}"
          SQLTask:TimeOut="0"
          SQLTask:SqlStatementSource="-- Dimensión Estilo: estilos distintos de work.csv + miembro &quot;Sin estilo&quot;&#10;INSERT INTO dbo.Dim_Estilo (Estilo)&#10;SELECT DISTINCT LTRIM(RTRIM(style))&#10;FROM stg.work&#10;WHERE NULLIF(LTRIM(RTRIM(style)), '') IS NOT NULL;&#10;INSERT INTO dbo.Dim_Estilo (Estilo) VALUES ('Sin estilo');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Dim_Tema"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{CC454B71-898F-48ED-9834-7E38973E285B}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Dim_Tema"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AC43ABAC-3A45-4CC0-8CC7-86391D0CC456}"
          SQLTask:TimeOut="0"
          SQLTask:SqlStatementSource="-- Dimensión Tema: los temas de cada obra se unen en una etiqueta (decisión B) + &quot;Sin tema&quot;&#10;INSERT INTO dbo.Dim_Tema (Tema)&#10;SELECT DISTINCT t.Tema&#10;FROM (SELECT work_id,&#10;             STRING_AGG(subject, ' / ') WITHIN GROUP (ORDER BY subject) AS Tema&#10;      FROM (SELECT DISTINCT CAST(work_id AS INT) AS work_id, LTRIM(RTRIM(subject)) AS subject&#10;            FROM stg.subject) s&#10;      GROUP BY work_id) t;&#10;INSERT INTO dbo.Dim_Tema (Tema) VALUES ('Sin tema');" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Dim_Obra"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{40EC15DE-74D9-4C83-A6B7-EEECD459BBDC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Dim_Obra"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AC43ABAC-3A45-4CC0-8CC7-86391D0CC456}"
          SQLTask:TimeOut="0"
          SQLTask:SqlStatementSource="-- Dimensión Obra: una fila por obra (work.csv sin duplicados + URL de image_link.csv)&#10;INSERT INTO dbo.Dim_Obra (work_id, NombreObra, UrlImagen)&#10;SELECT w.work_id, w.NombreObra, i.url&#10;FROM (SELECT CAST(work_id AS INT) AS work_id, MAX(LTRIM(RTRIM(name))) AS NombreObra&#10;      FROM stg.work&#10;      GROUP BY CAST(work_id AS INT)) w&#10;LEFT JOIN (SELECT CAST(work_id AS INT) AS work_id, MAX(url) AS url&#10;           FROM stg.image_link&#10;           GROUP BY CAST(work_id AS INT)) i ON i.work_id = w.work_id;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Registrar errores"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B0C310AC-A951-4588-B1B3-8AE95D267B62}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Registrar errores"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AC43ABAC-3A45-4CC0-8CC7-86391D0CC456}"
          SQLTask:TimeOut="0"
          SQLTask:SqlStatementSource="-- Gestión de errores (decisión A): precios cuyo tamaño no existe en canvas_size&#10;INSERT INTO stg.ErroresPrecio (work_id, size_id, sale_price, regular_price, Motivo)&#10;SELECT p.work_id, p.size_id, p.sale_price, p.regular_price,&#10;       CASE WHEN TRY_CAST(p.size_id AS INT) IS NULL THEN 'size_id no es un número entero'&#10;            ELSE 'size_id no existe en canvas_size' END&#10;FROM (SELECT DISTINCT work_id, size_id, sale_price, regular_price FROM stg.product_size) p&#10;WHERE NOT EXISTS (SELECT 1 FROM dbo.Dim_Tamano t WHERE t.size_id = TRY_CAST(p.size_id AS INT));" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Cargar Fact_PrecioObra"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{47141AC2-2874-4AF2-B1C1-A8BE38041E87}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Cargar Fact_PrecioObra"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AC43ABAC-3A45-4CC0-8CC7-86391D0CC456}"
          SQLTask:TimeOut="0"
          SQLTask:SqlStatementSource="-- Tabla de hechos. Grano: una fila por obra ofrecida en un tamaño de lienzo.&#10;-- Paso 1: preparar datos limpios en tablas temporales (más rápido que unir texto directamente)&#10;SELECT DISTINCT CAST(work_id AS INT) AS work_id,&#10;       TRY_CAST(size_id AS INT) AS size_id,&#10;       CAST(sale_price AS DECIMAL(10,2)) AS PrecioVenta,&#10;       CAST(regular_price AS DECIMAL(10,2)) AS PrecioRegular&#10;INTO #p&#10;FROM stg.product_size&#10;WHERE TRY_CAST(size_id AS INT) IS NOT NULL;&#10;&#10;SELECT CAST(work_id AS INT) AS work_id,&#10;       MAX(CAST(artist_id AS INT)) AS artist_id,&#10;       MAX(NULLIF(LTRIM(RTRIM(style)), '')) AS style,&#10;       MAX(TRY_CAST(NULLIF(LTRIM(RTRIM(museum_id)), '') AS INT)) AS museum_id&#10;INTO #w&#10;FROM stg.work&#10;GROUP BY CAST(work_id AS INT);&#10;CREATE UNIQUE CLUSTERED INDEX IX_w ON #w (work_id);&#10;&#10;SELECT work_id, STRING_AGG(subject, ' / ') WITHIN GROUP (ORDER BY subject) AS Tema&#10;INTO #t&#10;FROM (SELECT DISTINCT CAST(work_id AS INT) AS work_id, LTRIM(RTRIM(subject)) AS subject&#10;      FROM stg.subject) s&#10;GROUP BY work_id;&#10;CREATE UNIQUE CLUSTERED INDEX IX_t ON #t (work_id);&#10;&#10;-- Paso 2: buscar la clave sustituta de cada una de las 6 dimensiones e insertar&#10;INSERT INTO dbo.Fact_PrecioObra&#10;       (ObraKey, ArtistaKey, MuseoKey, TamanoKey, EstiloKey, TemaKey, PrecioVenta, PrecioRegular, Descuento)&#10;SELECT o.ObraKey, a.ArtistaKey, m.MuseoKey, tm.TamanoKey, e.EstiloKey, te.TemaKey,&#10;       p.PrecioVenta, p.PrecioRegular, p.PrecioRegular - p.PrecioVenta&#10;FROM #p p&#10;JOIN dbo.Dim_Tamano  tm ON tm.size_id  = p.size_id&#10;JOIN #w w               ON w.work_id   = p.work_id&#10;JOIN dbo.Dim_Obra    o  ON o.work_id   = w.work_id&#10;JOIN dbo.Dim_Artista a  ON a.artist_id = w.artist_id&#10;JOIN dbo.Dim_Museo   m  ON m.museum_id = ISNULL(w.museum_id, -1)&#10;JOIN dbo.Dim_Estilo  e  ON e.Estilo    = ISNULL(w.style, 'Sin estilo')&#10;LEFT JOIN #t t          ON t.work_id   = w.work_id&#10;JOIN dbo.Dim_Tema    te ON te.Tema     = ISNULL(t.Tema, 'Sin tema');&#10;&#10;DROP TABLE #p; DROP TABLE #w; DROP TABLE #t;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
